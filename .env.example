# ============================================================================
#  price-bot — ตัวอย่างค่าตั้งต้น
#  คัดลอกเป็น .env แล้วใส่ค่าจริง — ห้าม commit ไฟล์ .env
# ============================================================================

# ---------------------------------------------------------------------------
# 1) Edge Function (ตั้งที่ Supabase → Edge Functions → Secrets)
# ---------------------------------------------------------------------------
# ⚠️ service role key ข้ามทุก RLS — ใช้ได้เฉพาะฝั่งเซิร์ฟเวอร์
#    ห้ามใส่ในหน้าเว็บ ห้าม commit ห้ามวางในคอนโซลเบราว์เซอร์
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# โทเคนบอทจาก @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ข้อความสุ่มที่คุณตั้งเอง ใช้ยืนยันว่า webhook มาจาก Telegram จริง
# ต้องใช้ค่าเดียวกันตอนเรียก setWebhook
TELEGRAM_WEBHOOK_SECRET=สุ่มอะไรก็ได้ยาว ๆ

# chat id ที่อนุญาตให้ใช้บอท คั่นด้วยจุลภาค
# ว่างไว้ = ไม่อนุญาตใครเลย (ค่าเริ่มต้นที่ปลอดภัย)
# ยังไม่รู้ค่า? ทักบอทไปก่อน บอทจะตอบ chat id กลับมาให้
TELEGRAM_ALLOWED_CHAT_IDS=

# ---------------------------------------------------------------------------
# 2) สคริปต์อัปโหลด (scripts/upload.mjs) — รันบนเครื่องตัวเองเท่านั้น
# ---------------------------------------------------------------------------
# ใช้ SUPABASE_URL และ SUPABASE_SERVICE_ROLE_KEY ชุดเดียวกับข้างบน
